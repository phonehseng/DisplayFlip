#include <windows.h>
#include "resource.h"

IDI_APP ICON "../assets/displayflip.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "displayflip.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "DisplayFlip - one-button display, window and audio switching"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductName", "DisplayFlip"
      VALUE "ProductVersion", "1.0.0"
      VALUE "OriginalFilename", "DisplayFlip.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
